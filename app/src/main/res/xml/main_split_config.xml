<!-- Conversation list (left) and chat (right) side by side when the window is at least 600dp wide. -->
<resources xmlns:window="http://schemas.android.com/apk/res-auto">

    <SplitPairRule
        window:clearTop="true"
        window:finishPrimaryWithSecondary="never"
        window:finishSecondaryWithPrimary="always"
        window:splitMaxAspectRatioInPortrait="alwaysAllow"
        window:splitMinWidthDp="600"
        window:splitRatio="0.4">
        <SplitPairFilter
            window:primaryActivityName="com.nextcloud.talk.conversationlist.ConversationsListActivity"
            window:secondaryActivityName="com.nextcloud.talk.chat.ChatActivity" />
    </SplitPairRule>

    <SplitPlaceholderRule
        window:finishPrimaryWithPlaceholder="always"
        window:placeholderActivityName="com.nextcloud.talk.conversationlist.ChatPlaceholderActivity"
        window:splitMaxAspectRatioInPortrait="alwaysAllow"
        window:splitMinWidthDp="600"
        window:splitRatio="0.4"
        window:stickyPlaceholder="false">
        <ActivityFilter window:activityName="com.nextcloud.talk.conversationlist.ConversationsListActivity" />
    </SplitPlaceholderRule>

</resources>
